BEGIN
EXECUTE IMMEDIATE 'CREATE TABLE crew_dv_root(
   "_id"  number  GENERATED BY DEFAULT ON NULL AS IDENTITY,
   base  varchar2(64),
   name  varchar2(64)  /* UNIQUE */,
   rank  varchar2(64),
   PRIMARY KEY("_id")
)';

EXECUTE IMMEDIATE 'CREATE OR REPLACE JSON RELATIONAL DUALITY VIEW CREW_DV AS
crew_dv_root @insert @update @delete
{
  "_id"
  base
  name
  rank
}';
END;

